@model RegisterVm
@{ ViewData["Title"] = "Регистрация"; }
<div class="auth panel">
<h1>Регистрация</h1>
<form method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="error"></div>
    <label asp-for="FullName">Имя</label><input asp-for="FullName" />
    <span asp-validation-for="FullName" class="error"></span>
    <label asp-for="Email">Электронная почта</label><input asp-for="Email" />
    <span asp-validation-for="Email" class="error"></span>
    <label asp-for="Password">Пароль (минимум 8 символов)</label><input asp-for="Password" />
    <span asp-validation-for="Password" class="error"></span>
    <button class="button" type="submit">Создать аккаунт</button>
</form>
</div>
